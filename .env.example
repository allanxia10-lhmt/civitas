# Civitas runs fully in demo mode (browser localStorage) with no environment variables.
# Copy this file to .env.local (or add the values in Vercel → Settings → Environment Variables).

# --- Optional: accounts + cloud sync (Supabase) -------------------------------
# Create a Supabase project, run supabase/schema.sql, then fill these in.
# Project URL — Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe to expose in the browser; Row Level Security protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: AI-generated questions in Endless Practice (Claude) --------------
# Server-only secret — never prefix with NEXT_PUBLIC_. Without it, Endless Practice
# still works using the question bank plus questions generated from course content.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5)
# CIVITAS_AI_MODEL=
